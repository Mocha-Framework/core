{
  "name": "@mocha/core",
  "version": "0.1.0",
  "description": "Mocha Core — QObject system, QML components, design tokens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qml": {
      "types": "./dist/qml/index.d.ts",
      "import": "./dist/qml/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@mocha/bridge-api": "^0.1.0",
    "@mocha/bridge-napi": "^0.1.0",
    "@catppuccin/palette": "^1.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "vitest": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
